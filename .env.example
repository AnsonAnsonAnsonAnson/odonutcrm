# ---------- Required ----------
# Your public domain (DNS A record must point at this server). Caddy gets the HTTPS certificate.
DOMAIN=loyalty.odonut.hk
PUBLIC_URL=https://loyalty.odonut.hk
# Long random strings. Generate with: openssl rand -hex 32
APP_SECRET=
POSTGRES_PASSWORD=
# First owner login for /admin (only used when no staff exist yet). Change the password after first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
TZ_OFFSET_HOURS=8
# direct: visitors reach this server and Caddy gets the HTTPS certificate itself.
# cloudflare: set by scripts/cloudflare.sh; only Cloudflare may connect (docs/08-security.md).
CADDY_MODE=direct

# ---------- Email: sign-in codes (any SMTP provider: Resend, Postmark, SES, Gmail Workspace) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=O! Donut <hello@odonut.hk>

# ---------- SMS sign-in (optional, Twilio) ----------
# Lets existing members sign in with a text message code. Leave blank to keep email-only sign-in.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- Apple Wallet (see docs/04-apple-google-wallet-setup.md) ----------
# e.g. pass.hk.odonut.loyalty. Leave the two IDs blank until the certificate files are in ./secrets.
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT_FILE=/secrets/pass-cert.pem
APPLE_PASS_KEY_FILE=/secrets/pass-key.pem
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_FILE=/secrets/wwdr.pem

# ---------- Google Wallet (optional) ----------
GOOGLE_ISSUER_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=/secrets/google-wallet-sa.json

# ---------- Web push (generate with: npm run vapid -w server) ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@odonut.hk
