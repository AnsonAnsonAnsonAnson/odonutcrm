{
  "name": "@odonut/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts",
    "make-test-certs": "bash scripts/make-test-certs.sh",
    "vapid": "tsx src/cli/vapid.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.1.1",
    "passkit-generator": "^3.7.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
